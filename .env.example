# Variables are read from the process; this file is documentation, not auto-loaded.
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data/internal
DEMO_MODE=0
# Set the exact HTTPS origin behind your reverse proxy.
APP_ORIGIN=https://recruitment.example.com
# Trust only the real reverse proxy's address/CIDR. Local Vite/Nginx uses loopback.
TRUST_PROXY=loopback
