{
  "name": "supernet-recruitment-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "setup": "node scripts/setup.mjs",
    "scanner:check": "node scripts/scanner-check.mjs",
    "scanner:up": "docker compose -f compose.antivirus.yml up -d --wait && node scripts/scanner-check.mjs --clamav",
    "scanner:down": "docker compose -f compose.antivirus.yml down",
    "demo": "node scripts/demo.mjs",
    "pretest": "node scripts/scanner-check.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "tsc --noEmit",
    "create-user": "node scripts/create-user.mjs",
    "pretest:e2e": "node scripts/scanner-check.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "sharp": "^0.35.5",
    "undici": "^8.12.3",
    "unpdf": "^2.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
